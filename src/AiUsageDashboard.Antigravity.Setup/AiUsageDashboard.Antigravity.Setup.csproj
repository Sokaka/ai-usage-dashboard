<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>AiUsageDashboard.Antigravity.Setup</AssemblyName>
    <DefineConstants>$(DefineConstants);ANTIGRAVITY_SETUP_PRESENTATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AiUsageDashboard.App\PointerFocusRelease.cs"
             Link="PointerFocusRelease.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiUsageDashboard.Antigravity\AiUsageDashboard.Antigravity.csproj" />
  </ItemGroup>

  <!-- Setup UI 由 App 載入；共用套件版本必須一致。 -->
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

</Project>
