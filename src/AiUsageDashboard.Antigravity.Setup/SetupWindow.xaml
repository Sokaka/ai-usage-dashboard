<Window x:Class="AiUsageDashboard.Antigravity.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Windows.Setup.ConnectAntigravityAccount}"
        Icon="{DynamicResource ThemeWindowIcon}"
        Width="560"
        Height="640"
        MinWidth="420"
        MinHeight="360"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SetupControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="25"
                       FontWeight="SemiBold"
                       Text="{DynamicResource Windows.Setup.ConnectAntigravityAccount}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{DynamicResource Windows.Setup.EachWindowsUserUsuallyNeedsToSetThis}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,24,0,0"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Border x:Name="WelcomePanel"
                        Style="{StaticResource SetupPanelStyle}">
                    <StackPanel>
                        <TextBlock x:Name="WelcomeHeadingTextBlock"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Windows.Setup.PrepareToConnect}" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Windows.Setup.SignInToAntigravityFirstAIUsageAccepts}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,22,0,0"
                                Padding="13"
                                Background="{DynamicResource InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="{DynamicResource Windows.Setup.AIUsageStoresOnlyTheFourUsageValues}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button x:Name="StartButton"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Right"
                                Click="StartButton_Click"
                                Content="{DynamicResource Windows.Setup.ConnectAntigravityAccount}"
                                IsDefault="True"
                                IsEnabled="True"
                                Style="{StaticResource SetupPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ProgressPanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProgressHeadingTextBlock"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Windows.Setup.ConnectingAntigravity}" />
                        <TextBlock x:Name="ProgressTextBlock"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Windows.Setup.PreparingThisComputer}"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="ProgressIndicator"
                                     Margin="0,24,0,0"
                                     AutomationProperties.Name="{Binding Text, ElementName=ProgressTextBlock}"
                                     Focusable="True"
                                     FocusVisualStyle="{StaticResource SetupKeyboardFocusVisualStyle}"
                                     Height="7"
                                     IsIndeterminate="True"
                                     IsTabStop="False" />
                        <TextBlock Margin="0,18,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="{DynamicResource Windows.Setup.AIUsageDirectlyRunsOnlyOfficialReadOnly}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="ReviewPanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ReviewHeadingTextBlock"
                                   AutomationProperties.LiveSetting="Polite"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Windows.Setup.ReviewAccountAndUsage}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Windows.Setup.CheckThatTheFollowingIsTheCurrentAntigravity}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource Windows.Setup.Account}" />
                            <TextBlock x:Name="AccountIdentityTextBlock"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <ItemsControl x:Name="UsageWindowsItemsControl"
                                      Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9"
                                            Padding="12"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="12"
                                                           Text="{Binding ResetText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="18,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding RemainingText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="ApproveButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Click="ApproveButton_Click"
                                Content="{DynamicResource Windows.Setup.FinishConnecting}"
                                IsEnabled="True"
                                Style="{StaticResource SetupPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="FailurePanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FailureHeadingTextBlock"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Windows.Setup.AntigravityCannotBeConnectedRightNow}" />
                        <TextBlock x:Name="FailureGuidanceTextBlock"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Windows.Setup.FollowTheInstructionsBelowThenTryAgain}"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,20,0,0"
                                Padding="12"
                                Background="{DynamicResource DangerSurfaceBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock x:Name="FailureKindTextBlock"
                                       AutomationProperties.LiveSetting="Assertive"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Button x:Name="FailureDiagnosticDisclosureButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.HelpText="{DynamicResource Windows.Setup.ShowOrHideTechnicalInformationForMaintainersIt}"
                                AutomationProperties.LiveSetting="Polite"
                                Click="FailureDiagnosticDisclosureButton_Click"
                                Content="{DynamicResource Windows.Setup.ShowTechnicalInformation}"
                                Style="{StaticResource SetupGhostButtonStyle}" />
                        <StackPanel x:Name="FailureDiagnosticDetailsPanel"
                                    Visibility="Collapsed">
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="{DynamicResource Windows.Setup.TheFollowingContainsOnlyTheVersionFailureType}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <TextBlock x:Name="FailureDiagnosticTextBlock"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Border>
                            <Button x:Name="CopyDiagnosticButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.HelpText="{DynamicResource Windows.Setup.CopiesOnlyTheVersionFailureTypeLastStage}"
                                    Click="CopyDiagnosticButton_Click"
                                    Content="{DynamicResource Windows.Setup.CopyTechnicalInformation}"
                                    Style="{StaticResource SetupGhostButtonStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,22,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="RetryButton"
                                    Click="RetryButton_Click"
                                    Content="{DynamicResource Windows.Setup.TryAgain}"
                                    Style="{StaticResource SetupPrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="CompletedPanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="CompletedHeadingTextBlock"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Windows.Setup.AntigravityAccountConnected}" />
                        <TextBlock x:Name="CompletionTextBlock"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Windows.Setup.AIUsageWillCheckThisAccountSUsage}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="OpenAiUsageButton"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Right"
                                Click="OpenAiUsageButton_Click"
                                Content="{DynamicResource Windows.Setup.OpenAIUsage}"
                                Style="{StaticResource SetupPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusTextBlock"
                       Margin="0,0,12,0"
                       AutomationProperties.LiveSetting="Polite"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       Text="{DynamicResource Windows.Setup.NotStarted}"
                       TextWrapping="Wrap" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Click="CancelButton_Click"
                    Content="{DynamicResource Windows.Common.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource SetupGhostButtonStyle}" />
        </Grid>
    </Grid>
</Window>
