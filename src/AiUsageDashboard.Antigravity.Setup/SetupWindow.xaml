<Window x:Class="AiUsageDashboard.Antigravity.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="連接 Antigravity 帳號"
        Width="560"
        Height="640"
        MinWidth="420"
        MinHeight="360"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SetupControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="25"
                       FontWeight="SemiBold"
                       Text="連接 Antigravity 帳號" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="在同一台電腦上，每個 Windows 使用者通常只要設定一次。只有連接 Antigravity 時需要這項設定。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,24,0,0"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Border x:Name="WelcomePanel"
                        Style="{StaticResource SetupPanelStyle}">
                    <StackPanel>
                        <TextBlock x:Name="WelcomeHeadingTextBlock"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="準備連接" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="請先登入 Antigravity。AI Usage 只接受支援官方唯讀 /usage 的版本，會確認這台電腦上的官方 Antigravity CLI，再讀取目前帳號的四項用量供你確認。這張卡會跟隨這台電腦目前的 Antigravity 登入；AI Usage 無法確認或固定企業專案範圍。這項操作不會讀取登入憑證。"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,22,0,0"
                                Padding="13"
                                Background="{DynamicResource InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="AI Usage 只會儲存官方用量讀取流程回傳的四項用量、取得時間，以及這台電腦核准的 Antigravity CLI 來源。不會儲存完整 CLI 輸出、status line 內容或登入憑證，也不會安裝 status-line helper。官方 /usage 不提供電子郵件或方案，因此卡片會顯示為「目前登入的 Antigravity 帳號」。這張卡會跟隨這台電腦目前的 Antigravity 登入，AI Usage 無法確認或固定企業專案範圍。讀不到支援的版本或四項用量時，連接不會完成。"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button x:Name="StartButton"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Right"
                                Click="StartButton_Click"
                                Content="連接 Antigravity 帳號"
                                IsDefault="True"
                                IsEnabled="True"
                                Style="{StaticResource SetupPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ProgressPanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProgressHeadingTextBlock"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="正在連接 Antigravity" />
                        <TextBlock x:Name="ProgressTextBlock"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="正在準備這台電腦…"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="ProgressIndicator"
                                     Margin="0,24,0,0"
                                     AutomationProperties.Name="{Binding Text, ElementName=ProgressTextBlock}"
                                     Focusable="True"
                                     FocusVisualStyle="{StaticResource SetupKeyboardFocusVisualStyle}"
                                     Height="7"
                                     IsIndeterminate="True"
                                     IsTabStop="False" />
                        <TextBlock Margin="0,18,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="AI Usage 只會直接執行官方唯讀 /usage，且不會讀取登入憑證，也不會使用終端畫面擷取或 status-line helper。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="ReviewPanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ReviewHeadingTextBlock"
                                   AutomationProperties.LiveSetting="Polite"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="確認帳號與用量" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="請確認以下是這台電腦目前的 Antigravity 登入。這張卡會跟隨本機登入，AI Usage 無法確認或固定企業專案範圍。"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="帳號" />
                            <TextBlock x:Name="AccountIdentityTextBlock"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <ItemsControl x:Name="UsageWindowsItemsControl"
                                      Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9"
                                            Padding="12"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="12"
                                                           Text="{Binding ResetText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="18,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding RemainingText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="ApproveButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Click="ApproveButton_Click"
                                Content="完成連接"
                                IsEnabled="True"
                                Style="{StaticResource SetupPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="FailurePanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FailureHeadingTextBlock"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="目前無法連接 Antigravity" />
                        <TextBlock x:Name="FailureGuidanceTextBlock"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="請依照下方說明處理後再試一次。"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,20,0,0"
                                Padding="12"
                                Background="{DynamicResource DangerSurfaceBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock x:Name="FailureKindTextBlock"
                                       AutomationProperties.LiveSetting="Assertive"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Button x:Name="FailureDiagnosticDisclosureButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.HelpText="顯示或隱藏可供維護者判斷問題的技術資訊，不含帳號或私人路徑。"
                                AutomationProperties.LiveSetting="Polite"
                                Click="FailureDiagnosticDisclosureButton_Click"
                                Content="顯示技術資訊"
                                Style="{StaticResource SetupGhostButtonStyle}" />
                        <StackPanel x:Name="FailureDiagnosticDetailsPanel"
                                    Visibility="Collapsed">
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="以下只有版本、失敗類型、最後階段與建議處理方式。需要協助時，可提供給維護者。"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <TextBlock x:Name="FailureDiagnosticTextBlock"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Border>
                            <Button x:Name="CopyDiagnosticButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.HelpText="複製的內容只有版本、失敗類型、最後階段與建議處理方式，不含帳號或私人路徑。"
                                    Click="CopyDiagnosticButton_Click"
                                    Content="複製技術資訊"
                                    Style="{StaticResource SetupGhostButtonStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,22,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="RetryButton"
                                    Click="RetryButton_Click"
                                    Content="再試一次"
                                    Style="{StaticResource SetupPrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="CompletedPanel"
                        Style="{StaticResource SetupPanelStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="CompletedHeadingTextBlock"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Antigravity 帳號已連接" />
                        <TextBlock x:Name="CompletionTextBlock"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="AI Usage 會重新讀取這個帳號的用量。"
                                   TextWrapping="Wrap" />
                        <Button x:Name="OpenAiUsageButton"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Right"
                                Click="OpenAiUsageButton_Click"
                                Content="開啟 AI Usage"
                                Style="{StaticResource SetupPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,22,0,0">
            <TextBlock x:Name="FooterStatusTextBlock"
                       AutomationProperties.LiveSetting="Polite"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       Text="尚未開始" />
            <Button x:Name="CancelButton"
                    HorizontalAlignment="Right"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource SetupGhostButtonStyle}" />
        </Grid>
    </Grid>
</Window>
