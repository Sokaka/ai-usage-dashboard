<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AiUsageDashboard.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- This is a WPF app; process DPI awareness must be set before its first HWND exists. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\使用說明.md"
             Link="README.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third-party-notices\GitHub-Copilot-SDK-LICENSE.md"
             Link="third-party-notices\GitHub-Copilot-SDK-LICENSE.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third-party-notices\*"
             Exclude="..\..\third-party-notices\GitHub-Copilot-SDK-LICENSE.md"
             Link="third-party-notices\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <!-- App 與內嵌的 Setup UI 共用同一個 self-contained runtime，這些套件版本必須一致。 -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiUsageDashboard.Antigravity\AiUsageDashboard.Antigravity.csproj" />
    <ProjectReference Include="..\AiUsageDashboard.Antigravity.Setup\AiUsageDashboard.Antigravity.Setup.csproj" />
    <ProjectReference Include="..\AiUsageDashboard.ClaudeCapture\AiUsageDashboard.ClaudeCapture.csproj" />
    <ProjectReference Include="..\AiUsageDashboard.Core\AiUsageDashboard.Core.csproj" />
    <ProjectReference Include="..\AiUsageDashboard.Updater.Core\AiUsageDashboard.Updater.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AiUsageDashboard.UpdateFeedUrl"
                      Value="$(UpdateFeedUrl)"
                      Condition="'$(UpdateFeedUrl)' != ''" />
    <AssemblyMetadata Include="AiUsageDashboard.UpdateChannel"
                      Value="$(UpdateChannel)"
                      Condition="'$(UpdateChannel)' != ''" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateTrustedKeysFile)' != ''">
    <EmbeddedResource Include="$(UpdateTrustedKeysFile)"
                      LogicalName="AiUsageDashboard.UpdateTrustedKeys.json" />
  </ItemGroup>

  <Target Name="RequireUpdateFeedMetadataForPublish"
          BeforeTargets="PrepareForPublish">
    <Error Condition="'$(UpdateFeedUrl)' == ''"
           Text="Publishing the app requires UpdateFeedUrl." />
    <Error Condition="'$(UpdateChannel)' == ''"
           Text="Publishing the app requires UpdateChannel." />
    <Error Condition="'$(UpdateTrustedKeysFile)' == '' Or !Exists('$(UpdateTrustedKeysFile)')"
           Text="Publishing the app requires an externally supplied UpdateTrustedKeysFile containing production public trust keys." />
  </Target>

  <Target Name="ValidateUnbundledCopilotRuntime"
          BeforeTargets="BeforeBuild;_DownloadCopilotCli;_CopyCopilotCliToOutput;_RegisterCopilotCliForCopy">
    <Error Condition="'$(CopilotSkipCliDownload)' != 'true' Or '$(CopilotCliBinaryPath)' != ''"
           Text="AI Usage uses a user-installed Copilot CLI. SDK CLI downloads and bundled binary overrides must remain disabled." />
  </Target>

  <Target Name="RemoveBundledCopilotRuntimeFromOutput"
          BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
          AfterTargets="Build"
          Condition="'$(OutDir)' != ''">
    <ItemGroup>
      <_BundledCopilotOutputFiles Include="$(OutDir)runtimes\**\native\copilot.exe;$(OutDir)runtimes\**\native\copilot;$(OutDir)runtimes\**\native\copilot_runtime.dll;$(OutDir)runtimes\**\native\libcopilot_runtime.*;$(OutDir)third-party-notices\GitHub-Copilot-CLI-LICENSE.md" />
    </ItemGroup>
    <Delete Files="@(_BundledCopilotOutputFiles)" />
    <Error Condition="Exists('%(_BundledCopilotOutputFiles.Identity)')"
           Text="Obsolete bundled Copilot content could not be removed: %(_BundledCopilotOutputFiles.Identity)" />
  </Target>

  <Target Name="RemoveBundledCopilotRuntimeFromPublish"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_BundledCopilotPublishFiles Include="$(PublishDir)runtimes\**\native\copilot.exe;$(PublishDir)runtimes\**\native\copilot;$(PublishDir)runtimes\**\native\copilot_runtime.dll;$(PublishDir)runtimes\**\native\libcopilot_runtime.*;$(PublishDir)third-party-notices\GitHub-Copilot-CLI-LICENSE.md" />
    </ItemGroup>
    <Delete Files="@(_BundledCopilotPublishFiles)" />
    <Error Condition="Exists('%(_BundledCopilotPublishFiles.Identity)')"
           Text="Obsolete bundled Copilot content could not be removed: %(_BundledCopilotPublishFiles.Identity)" />
  </Target>

  <Target Name="RemoveCrashDumpToolFromPublish"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <Delete Files="$(PublishDir)createdump.exe" />
    <Error Condition="Exists('$(PublishDir)createdump.exe')"
           Text="The .NET crash-dump helper must not be present in the published application." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AiUsageDashboard.Licensing\AiUsageDashboard.Licensing.csproj" />
    <Compile Include="..\Shared\Licensing\LegalTermsDialog.cs" Link="LegalTermsDialog.cs" />
  </ItemGroup>

</Project>
