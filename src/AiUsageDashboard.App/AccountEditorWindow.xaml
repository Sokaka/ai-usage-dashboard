<Window x:Class="AiUsageDashboard.App.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帳號設定"
        Width="460"
        MinWidth="380"
        MinHeight="320"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="FormScrollViewer"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Text="新增帳號" />
                    <TextBlock x:Name="SubtitleTextBlock"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="選擇服務並設定帳號。" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,24,0,0">
                    <Label Padding="0"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Content="服務"
                           Target="{Binding ElementName=ProviderComboBox}" />
                    <ComboBox x:Name="ProviderComboBox"
                              Margin="0,7,0,0"
                              Padding="10,7"
                              AutomationProperties.HelpText="選擇要顯示用量的服務"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              SelectionChanged="ProviderComboBox_SelectionChanged"
                              SelectedValuePath="Provider"
                              TextSearch.TextPath="SearchText">
                        <ComboBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}"
                                   TargetType="{x:Type ComboBoxItem}">
                                <Setter Property="AutomationProperties.Name"
                                        Value="{Binding DisplayName}" />
                                <Setter Property="AutomationProperties.HelpText"
                                        Value="{Binding UnavailableReason}" />
                                <Setter Property="IsEnabled"
                                        Value="{Binding IsEnabled}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock x:Name="UnavailableReasonTextBlock"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontSize="11"
                                               Text="{Binding UnavailableReason}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}"
                                                 Value="False">
                                        <Setter TargetName="UnavailableReasonTextBlock"
                                                Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="ProviderHintTextBlock"
                               Margin="0,7,0,0"
                               MinHeight="34"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="DisplayNamePanel"
                            Grid.Row="2"
                            Margin="0,20,0,0">
                    <Label Padding="0"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Content="暱稱（選填）"
                           Target="{Binding ElementName=DisplayNameTextBox}" />
                    <TextBox x:Name="DisplayNameTextBox"
                             Margin="0,7,0,0"
                             Padding="10,8"
                             AutomationProperties.HelpText="留白時不顯示暱稱"
                             MaxLength="80"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="DisplayNameHintTextBlock"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Text="留白時不顯示暱稱。"
                               TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox x:Name="EnabledCheckBox"
                          Grid.Row="3"
                          Margin="0,20,0,0"
                          Checked="EnabledCheckBox_CheckStateChanged"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          Content="開始檢查用量"
                          IsChecked="True"
                          Unchecked="EnabledCheckBox_CheckStateChanged" />

                <StackPanel Grid.Row="4"
                            Margin="0,26,0,0">
                    <Border x:Name="ProviderNoticePanel"
                            Padding="12"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ProviderNoticeTitleTextBlock"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="連接前注意事項" />
                            <TextBlock x:Name="ProviderNoticeTextBlock"
                                       Margin="0,7,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="AccountConnectionPanel"
                            Padding="12"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="帳號連接" />
                            <TextBlock x:Name="AccountTextBlock"
                                       Margin="0,7,0,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="AccountConnectionHintTextBlock"
                                       Margin="0,5,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <Button x:Name="ConnectAccountButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Click="ConnectAccountButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="12"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="儲存的資料" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="AI Usage 會儲存卡片設定、帳號資訊和上次用量，不會儲存密碼。"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ProviderStoredDataTextBlock"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <WrapPanel x:Name="FooterActionsPanel"
                   Grid.Row="1"
                   Margin="0,20,0,0"
                   HorizontalAlignment="Right">
            <Button Margin="0,0,10,8"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button x:Name="SaveOnlyButton"
                    Margin="0,0,10,8"
                    Click="SaveOnlyButton_Click"
                    Content="儲存"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button x:Name="SaveAndConnectButton"
                    Margin="0,0,0,8"
                    Click="SaveAndConnectButton_Click"
                    Content="儲存並連接"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </WrapPanel>
    </Grid>
</Window>
