<Window x:Class="AiUsageDashboard.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Windows.About.AboutAIUsage}"
        Icon="{DynamicResource ThemeWindowIcon}"
        Width="470"
        MinWidth="320"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <DockPanel>
                <ContentControl Width="46"
                                Height="46"
                                Margin="0,0,14,0"
                                Focusable="False"
                                Style="{StaticResource ThemeLogoStyle}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Text="AI Usage" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource Windows.About.ViewYourAISubscriptionUsageOnTheDesktop}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Label Margin="0,22,0,6"
                   Padding="0"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Content="{DynamicResource Windows.About.Version}"
                   Target="{Binding ElementName=VersionTextBox}" />
            <TextBox x:Name="VersionTextBox"
                     AutomationProperties.AutomationId="AboutVersion"
                     AutomationProperties.HelpText="{DynamicResource Windows.About.TheFullRunningVersionSelectItToCopy}"
                     IsReadOnly="True"
                     TextWrapping="Wrap" />
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="CopyVersionButton"
                        AutomationProperties.AutomationId="CopyAboutVersion"
                        Click="CopyVersionButton_Click"
                        Content="{DynamicResource Windows.About.CopyVersion}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock x:Name="CopyStatusTextBlock"
                           Margin="12,8,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </WrapPanel>

            <Label Margin="0,18,0,6"
                   Padding="0"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Content="{DynamicResource Windows.About.Updates}" />
            <TextBlock x:Name="UpdateStatusTextBlock"
                       AutomationProperties.AutomationId="AboutUpdateStatus"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{DynamicResource Windows.About.UpdatesHaveNotBeenCheckedYet}"
                       TextWrapping="Wrap" />
            <Button x:Name="CheckForUpdatesButton"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="CheckForUpdates"
                    Click="CheckForUpdatesButton_Click"
                    Content="{DynamicResource Windows.About.CheckForUpdates}"
                    Style="{StaticResource SecondaryButtonStyle}" />

            <WrapPanel Margin="0,22,0,0">
                <Button Margin="0,0,8,8"
                        Click="UserGuideButton_Click"
                        Content="{DynamicResource Windows.About.UserGuide}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="0,0,8,8"
                        Click="ReleasesButton_Click"
                        Content="{DynamicResource Windows.About.DownloadsAndReleaseNotes}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="0,0,0,8"
                        Click="ReportIssueButton_Click"
                        Content="{DynamicResource Windows.About.ReportAnIssue}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </WrapPanel>

            <Button Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    Content="{DynamicResource Windows.Common.Close}"
                    IsCancel="True"
                    Style="{StaticResource GhostButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</Window>
