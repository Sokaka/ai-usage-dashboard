<Window x:Class="AiUsageDashboard.App.CodexResetCreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 重置券"
        Icon="{DynamicResource ThemeWindowIcon}"
        Width="410"
        MinWidth="320"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Text="{Binding AvailableCountText}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{Binding AccountText}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11"
                       Text="{Binding FetchedAtText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasFetchedAtText, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,0"
                      MaxHeight="400"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,10"
                           Foreground="{DynamicResource WarningTextBrush}"
                           Text="{Binding StaleText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Margin="0,0,0,10"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding DetailStateText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasDetailState, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{Binding CreditRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Heading}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource ResetTimeTextStyle}"
                                               Text="{Binding ExpiresAtText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="CloseCodexResetCredits"
                Click="CloseButton_Click"
                Content="關閉"
                IsCancel="True"
                Style="{StaticResource GhostButtonStyle}" />
    </Grid>
</Window>
