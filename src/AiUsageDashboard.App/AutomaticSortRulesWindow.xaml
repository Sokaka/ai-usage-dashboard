<Window x:Class="AiUsageDashboard.App.AutomaticSortRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Windows.SortRules.AutomaticSortRules}"
        Icon="{DynamicResource ThemeWindowIcon}"
        Width="460"
        MinWidth="320"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Windows.SortRules.HowAreCardsSorted}" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{DynamicResource Windows.SortRules.AutomaticSortingChangesOnlyTheOrderOfCards}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,22,0,6"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Windows.SortRules.1ServiceOrder}" />
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Claude → Codex → Antigravity → Grok → Copilot"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,18,0,6"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Windows.SortRules.2CardsFromTheSameService}" />
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{DynamicResource Windows.SortRules.ResetTimesAreComparedInOrder5Hour}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,18,0,6"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Windows.SortRules.3OtherCases}" />
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{DynamicResource Windows.SortRules.MissingOrPastResetTimesComeLastFor}"
                           TextWrapping="Wrap" />

                <Border Margin="0,22,0,0"
                        Padding="12"
                        Background="{DynamicResource InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource InfoBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{DynamicResource Windows.SortRules.UsagePercentagesDoNotAffectSortingSwitchingBack}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="1"
                Margin="0,22,0,0"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{DynamicResource Windows.SortRules.CloseAutomaticSortRules}"
                Click="CloseButton_Click"
                Content="{DynamicResource Windows.SortRules.GotIt}"
                IsCancel="True"
                Style="{StaticResource GhostButtonStyle}" />
    </Grid>
</Window>
