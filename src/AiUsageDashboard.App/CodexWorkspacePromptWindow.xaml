<Window x:Class="AiUsageDashboard.App.CodexWorkspacePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="連接 Codex"
        Width="460"
        MinWidth="380"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Text="選擇連接方式" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="只需要一張 Codex 卡片時，選「一般帳號連接」。"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="同一個 ChatGPT 帳號若要用多張卡片顯示不同 workspace，才需要 workspace ID。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Button x:Name="DefaultConnectionButton"
                Grid.Row="1"
                Margin="0,22,0,0"
                Padding="14,10"
                Click="ContinueWithoutWorkspaceButton_Click"
                Content="一般帳號連接"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />

        <StackPanel Grid.Row="2"
                    Margin="0,24,0,0">
            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="SemiBold"
                       Text="每個 workspace 各一張卡片" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Text="workspace 是 ChatGPT 裡的工作空間，不是電腦資料夾，也不是訂閱方案。"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Text="每張卡片都要填入對應的 workspace ID，原本的第一張也一樣。"
                       TextWrapping="Wrap" />
            <Label Margin="0,14,0,0"
                   Padding="0"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Content="ChatGPT workspace ID"
                   Target="{Binding ElementName=WorkspaceIdTextBox}" />
            <TextBox x:Name="WorkspaceIdTextBox"
                     Margin="0,7,0,0"
                     Padding="10,8"
                     AutomationProperties.HelpText="輸入 ChatGPT workspace 管理者提供的 ID（UUID 格式）"
                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     PreviewKeyDown="WorkspaceIdTextBox_PreviewKeyDown" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Text="請向 ChatGPT workspace 管理者索取 ID。AI Usage 無法從電子郵件、ChatGPT 帳號或方案查出。"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Text="ID 會寫入這張卡片的 Codex 設定。用 ChatGPT 登入 Codex 時，只能使用指定的 workspace。"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Text="ID 不會放進匯出的設定檔。重新連接時要再輸入一次。"
                       TextWrapping="Wrap" />
            <Button Margin="0,14,0,0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource AccentSurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Click="ContinueWithWorkspaceButton_Click"
                    Content="用 workspace ID 連接"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

        <WrapPanel Grid.Row="3"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Right">
            <Button Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource GhostButtonStyle}" />
        </WrapPanel>
    </Grid>
</Window>
