<Window x:Class="AiUsageDashboard.App.CodexWorkspacePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Windows.Workspace.ConnectCodex}"
        Icon="{DynamicResource ThemeWindowIcon}"
        Width="460"
        MinWidth="380"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="HeadingTextBlock"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Text="{DynamicResource Windows.Workspace.ChooseAConnectionMethod}" />
                    <TextBlock x:Name="ConnectionHintTextBlock"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource Windows.Workspace.ChooseStandardAccountConnectionIfYouOnlyNeed}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource Windows.Workspace.AWorkspaceIDIsNeededOnlyWhenDisplaying}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,22,0,0">
                    <Button x:Name="DefaultConnectionButton"
                            Padding="14,10"
                            Click="ContinueWithoutWorkspaceButton_Click"
                            Content="{DynamicResource Windows.Workspace.StandardAccountConnection}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock x:Name="WorkspaceScopeChangeTextBlock"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontSize="12"
                               Text="{DynamicResource Windows.Workspace.SwitchingToAStandardAccountConnectionRemovesThis}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               Text="{DynamicResource Windows.Workspace.OneCardPerWorkspace}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Text="{DynamicResource Windows.Workspace.AWorkspaceIsASpaceWithinChatGPTRather}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Text="{DynamicResource Windows.Workspace.EnterTheMatchingWorkspaceIDForEveryCard}"
                               TextWrapping="Wrap" />
                    <Label Margin="0,14,0,0"
                           Padding="0"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Content="ChatGPT workspace ID"
                           Target="{Binding ElementName=WorkspaceIdTextBox}" />
                    <TextBox x:Name="WorkspaceIdTextBox"
                             Margin="0,7,0,0"
                             Padding="10,8"
                             AutomationProperties.HelpText="{DynamicResource Windows.Workspace.EnterTheIDProvidedByYourChatGPTWorkspace}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             PreviewKeyDown="WorkspaceIdTextBox_PreviewKeyDown" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Text="{DynamicResource Windows.Workspace.AskYourChatGPTWorkspaceAdministratorForTheID}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Text="{DynamicResource Windows.Workspace.TheIDIsWrittenToThisCardS}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Text="{DynamicResource Windows.Workspace.TheIDIsNotIncludedInExportedSettings}"
                               TextWrapping="Wrap" />
                    <Button x:Name="WorkspaceConnectionButton"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentSurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Click="ContinueWithWorkspaceButton_Click"
                            Content="{DynamicResource Windows.Workspace.ConnectWithWorkspaceID}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <WrapPanel Grid.Row="1"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Right">
            <Button Click="CancelButton_Click"
                    Content="{DynamicResource Windows.Common.Cancel}"
                    IsCancel="True"
                    Style="{StaticResource GhostButtonStyle}" />
        </WrapPanel>
    </Grid>
</Window>
