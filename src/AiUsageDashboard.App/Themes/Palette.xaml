<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base surfaces -->
    <Color x:Key="WindowBackgroundColor">#0B1120</Color>
    <Color x:Key="CardBackgroundColor">#151E2F</Color>
    <Color x:Key="SurfaceRaisedColor">#1E293B</Color>
    <Color x:Key="SurfaceOverlayColor">#F21E293B</Color>
    <Color x:Key="ControlBackgroundColor">#253047</Color>
    <Color x:Key="ControlHoverBackgroundColor">#30405C</Color>
    <Color x:Key="ControlPressedBackgroundColor">#1D293D</Color>
    <Color x:Key="ProgressTrackColor">#26344B</Color>

    <!-- Text and borders -->
    <Color x:Key="PrimaryTextColor">#F8FAFC</Color>
    <Color x:Key="SecondaryTextColor">#A8B6CA</Color>
    <Color x:Key="MutedTextColor">#8B9BB2</Color>
    <Color x:Key="DisabledTextColor">#64748B</Color>
    <Color x:Key="BorderColor">#3B4A63</Color>
    <Color x:Key="BorderStrongColor">#5A6B84</Color>
    <Color x:Key="InputBorderColor">#52637D</Color>
    <Color x:Key="InputBorderStrongColor">#71829B</Color>

    <!-- Semantic accents -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentPressedColor">#1E40AF</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="FocusColor">#7DD3FC</Color>
    <Color x:Key="AccentFocusColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningTextColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerTextColor">#F87171</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>

    <!-- Logo -->
    <Color x:Key="LogoSurfaceColor">#19253A</Color>
    <Color x:Key="LogoBorderColor">#60A5FA</Color>
    <Color x:Key="LogoPrimaryColor">#38BDF8</Color>
    <Color x:Key="LogoSecondaryColor">#818CF8</Color>
    <Color x:Key="LogoSparkColor">#F8FAFC</Color>
    <Color x:Key="ThemeDecorationColor">#00FFFFFF</Color>

    <!-- Provider accents -->
    <Color x:Key="ClaudeProviderAccentColor">#D97757</Color>
    <Color x:Key="CodexProviderAccentColor">#818CF8</Color>
    <Color x:Key="CopilotProviderAccentColor">#F472B6</Color>
    <Color x:Key="AntigravityProviderAccentColor">#06B6D4</Color>
    <Color x:Key="GrokProviderAccentColor">#E4E4E7</Color>
    <Color x:Key="DefaultProviderAccentColor">#94A3B8</Color>
    <!-- 深色小字略提亮，補足筆畫邊緣混色造成的視覺落差。 -->
    <Color x:Key="ClaudeProviderTextColor">#DC8264</Color>
    <Color x:Key="CodexProviderTextColor">#8B95F9</Color>
    <Color x:Key="CopilotProviderTextColor">#F57DBC</Color>
    <Color x:Key="AntigravityProviderTextColor">#1ABCD7</Color>
    <Color x:Key="GrokProviderTextColor">#E4E4E7</Color>

    <!-- Semantic surfaces -->
    <Color x:Key="AccentSurfaceColor">#262563EB</Color>
    <Color x:Key="SuccessSurfaceColor">#2434D399</Color>
    <Color x:Key="WarningSurfaceColor">#2AFBBF24</Color>
    <Color x:Key="DangerSurfaceColor">#3A7F1D1D</Color>
    <Color x:Key="DangerHoverSurfaceColor">#5A991B1B</Color>
    <Color x:Key="DangerPressedSurfaceColor">#6A7F1D1D</Color>
    <Color x:Key="InfoSurfaceColor">#2438BDF8</Color>

    <!-- Scrolling and selection -->
    <Color x:Key="ScrollBarThumbColor">#26344B</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#34445C</Color>
    <Color x:Key="ScrollBarThumbPressedColor">#42546D</Color>
    <Color x:Key="SelectionColor">#662563EB</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush"
                     Color="{DynamicResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush"
                     Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush"
                     Color="{DynamicResource SurfaceOverlayColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush"
                     Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush"
                     Color="{DynamicResource ControlHoverBackgroundColor}" />
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush"
                     Color="{DynamicResource ControlPressedBackgroundColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush"
                     Color="{DynamicResource ProgressTrackColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush"
                     Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush"
                     Color="{DynamicResource DisabledTextColor}" />
    <SolidColorBrush x:Key="BorderBrush"
                     Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"
                     Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="InputBorderBrush"
                     Color="{DynamicResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputBorderStrongBrush"
                     Color="{DynamicResource InputBorderStrongColor}" />

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush"
                     Color="{DynamicResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush"
                     Color="{DynamicResource AccentTextColor}" />
    <SolidColorBrush x:Key="FocusBrush"
                     Color="{DynamicResource FocusColor}" />
    <SolidColorBrush x:Key="AccentFocusBrush"
                     Color="{DynamicResource AccentFocusColor}" />
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush"
                     Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="WarningTextBrush"
                     Color="{DynamicResource WarningTextColor}" />
    <SolidColorBrush x:Key="DangerBrush"
                     Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="DangerTextBrush"
                     Color="{DynamicResource DangerTextColor}" />
    <SolidColorBrush x:Key="InfoBrush"
                     Color="{DynamicResource InfoColor}" />

    <SolidColorBrush x:Key="LogoSurfaceBrush"
                     Color="{DynamicResource LogoSurfaceColor}" />
    <SolidColorBrush x:Key="LogoBorderBrush"
                     Color="{DynamicResource LogoBorderColor}" />
    <SolidColorBrush x:Key="LogoPrimaryBrush"
                     Color="{DynamicResource LogoPrimaryColor}" />
    <SolidColorBrush x:Key="LogoSecondaryBrush"
                     Color="{DynamicResource LogoSecondaryColor}" />
    <SolidColorBrush x:Key="LogoSparkBrush"
                     Color="{DynamicResource LogoSparkColor}" />
    <SolidColorBrush x:Key="ThemeDecorationBrush"
                     Color="{DynamicResource ThemeDecorationColor}" />
    <LinearGradientBrush x:Key="LogoOrbitBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0"
                      Color="{StaticResource LogoPrimaryColor}" />
        <GradientStop Offset="1"
                      Color="{StaticResource LogoSecondaryColor}" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ClaudeProviderAccentBrush"
                     Color="{DynamicResource ClaudeProviderAccentColor}" />
    <SolidColorBrush x:Key="CodexProviderAccentBrush"
                     Color="{DynamicResource CodexProviderAccentColor}" />
    <SolidColorBrush x:Key="CopilotProviderAccentBrush"
                     Color="{DynamicResource CopilotProviderAccentColor}" />
    <SolidColorBrush x:Key="AntigravityProviderAccentBrush"
                     Color="{DynamicResource AntigravityProviderAccentColor}" />
    <SolidColorBrush x:Key="GrokProviderAccentBrush"
                     Color="{DynamicResource GrokProviderAccentColor}" />
    <SolidColorBrush x:Key="ClaudeProviderTextBrush"
                     Color="{DynamicResource ClaudeProviderTextColor}" />
    <SolidColorBrush x:Key="CodexProviderTextBrush"
                     Color="{DynamicResource CodexProviderTextColor}" />
    <SolidColorBrush x:Key="CopilotProviderTextBrush"
                     Color="{DynamicResource CopilotProviderTextColor}" />
    <SolidColorBrush x:Key="AntigravityProviderTextBrush"
                     Color="{DynamicResource AntigravityProviderTextColor}" />
    <SolidColorBrush x:Key="GrokProviderTextBrush"
                     Color="{DynamicResource GrokProviderTextColor}" />

    <SolidColorBrush x:Key="DefaultProviderAccentBrush"
                     Color="{DynamicResource DefaultProviderAccentColor}" />

    <SolidColorBrush x:Key="AccentSurfaceBrush"
                     Color="{DynamicResource AccentSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush"
                     Color="{DynamicResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush"
                     Color="{DynamicResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush"
                     Color="{DynamicResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="DangerHoverSurfaceBrush"
                     Color="{DynamicResource DangerHoverSurfaceColor}" />
    <SolidColorBrush x:Key="DangerPressedSurfaceBrush"
                     Color="{DynamicResource DangerPressedSurfaceColor}" />
    <SolidColorBrush x:Key="InfoSurfaceBrush"
                     Color="{DynamicResource InfoSurfaceColor}" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush"
                     Color="{DynamicResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush"
                     Color="{DynamicResource ScrollBarThumbHoverColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush"
                     Color="{DynamicResource ScrollBarThumbPressedColor}" />
    <SolidColorBrush x:Key="SelectionBrush"
                     Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="TransparentBrush"
                     Color="Transparent" />
</ResourceDictionary>
